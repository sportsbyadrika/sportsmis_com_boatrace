# SportsMIS Regatta env example. Copy to app/.env on the server and fill in
# real values. app/.env is gitignored and read by app/public/index.php on
# every request (manual line parser -> putenv). Never commit a populated .env.

# -- Application ------------------------------------------------------------
APP_ENV=production
APP_URL=https://regatta.sportsmis.com
APP_SECRET=change-this-secret-key-in-production

# -- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sportsmis_regatta
DB_USERNAME=
DB_PASSWORD=

# -- Mail (SMTP, optional -- used for account credential mails later) -------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@sportsmis.com
MAIL_FROM_NAME=SportsMIS Regatta

# -- Displays ---------------------------------------------------------------
# Chroma-key colour used by the YouTube green-screen overlay. Any CSS colour.
DISPLAY_CHROMA_COLOR=#00b140
