# ═══════════════════════════════════════════════════════════════════════════
# SportsMIS® Regatta — environment sample.
#
# Copy this file to app/.env on the server and fill in the real values:
#
#     cp app/.env.example app/.env
#
# app/.env is gitignored (it must never be committed) and is read by
# app/public/index.php on every request through a small line parser that
# calls putenv(). app/config/app.php and app/config/database.php read the
# values back with getenv(), each with the fallback shown in the comments
# below — so a missing key degrades to a sane default rather than a crash.
#
# Values with spaces may be quoted; the parser strips one layer of matching
# single or double quotes. Lines starting with # are ignored.
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────

# 'local' turns on error display and full stack traces, and drops the
# "secure" flag from the session cookie so it works over plain HTTP.
# Anything else (use 'production') keeps errors in the log only.
APP_ENV=production

# Absolute base URL, no trailing slash. Used by url() to build the
# copy-and-paste display-screen links shown in the race office.
APP_URL=https://boatrace.olympicday.in

# HMAC key behind the obfuscated URL ids (Core\Hash). CHANGE THIS — the
# default is public knowledge, and anyone with it can mint valid ids.
# Generate one with:  php -r 'echo bin2hex(random_bytes(32)), "\n";'
APP_SECRET=change-this-secret-key-in-production

# ── Database ───────────────────────────────────────────────────────────────
# On cPanel the database and user names are prefixed with the account name,
# e.g. olympicd_regatta / olympicd_regatta. Create both under
# MySQL® Databases and grant ALL PRIVILEGES before the first request.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=olympicd_regatta
DB_USERNAME=olympicd_regatta
DB_PASSWORD=

# ── Mail (SMTP) ────────────────────────────────────────────────────────────
# Reserved for the credential mails noted in docs/ARCHITECTURE.md §6. No
# mailer is wired up yet, so generated passwords are shown once in a flash
# message instead. Leaving these blank changes nothing today.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@olympicday.in
MAIL_FROM_NAME=SportsMIS Regatta

# ── Display screens ────────────────────────────────────────────────────────
# Default chroma-key colour for the YouTube / OBS stream overlay, applied to
# new events. Each event can override it under Event Details → Display
# Screens, and an operator can override it per session with ?chroma=#rrggbb.
DISPLAY_CHROMA_COLOR=#00b140
